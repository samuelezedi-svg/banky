{
  "manifest_version": 3,
  "name": "NairaShield",
  "version": "1.1.0",
  "description": "Spot fake Nigerian bank and fintech links before you tap.",
  "permissions": ["tabs", "storage", "webNavigation", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "NairaShield",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/lib/banks.js",
        "src/lib/detect.js",
        "src/lib/storage.js",
        "src/content/content.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/warning/warning.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
